{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EF Core Tests",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "vstest",
        "${workspaceFolder}/artifacts/bin/EFCore.Tests/Debug/net10.0"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
